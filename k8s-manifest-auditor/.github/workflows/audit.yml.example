name: k8s-manifest-audit

on:
  pull_request:
    paths:
      - "**/*.yaml"
      - "**/*.yml"
      - "k8s-manifest-auditor/**"
  push:
    branches: [main]

jobs:
  audit:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: k8s-manifest-auditor
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run unit tests
        run: pytest -q tests/

      - name: Audit manifests
        run: |
          python -m src.cli audit ../ \
            --policy policy.yaml \
            --json reports/audit.json \
            --markdown reports/audit.md \
            --fail-level high

      - name: Upload audit report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: audit-report
          path: k8s-manifest-auditor/reports/

      - name: Comment audit summary on PR
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const md = fs.readFileSync(
              'k8s-manifest-auditor/reports/audit.md',
              'utf8'
            );
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: md.length > 60000 ? md.slice(0, 60000) + '\n\n…truncated' : md,
            });
